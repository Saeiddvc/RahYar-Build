diff -ruN Run42Base/app/src/test/java/ir/rahyar/app/core/navigation/DriverAlertEvaluatorTest.kt Run43Source/app/src/test/java/ir/rahyar/app/core/navigation/DriverAlertEvaluatorTest.kt
--- Run42Base/app/src/test/java/ir/rahyar/app/core/navigation/DriverAlertEvaluatorTest.kt	1970-01-01 00:00:00.000000000 +0000
+++ Run43Source/app/src/test/java/ir/rahyar/app/core/navigation/DriverAlertEvaluatorTest.kt	2026-08-31 04:31:37.735917266 +0000
@@ -0,0 +1,44 @@
+package ir.rahyar.app.core.navigation
+
+import ir.rahyar.app.domain.models.DriverAlertKind
+import ir.rahyar.app.domain.models.LatLng
+import ir.rahyar.app.domain.models.RoadEvent
+import ir.rahyar.app.domain.models.RoadEventType
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class DriverAlertEvaluatorTest {
+    @Test
+    fun overspeedBeatsApproachingWarning() {
+        val alert = evaluateDriverAlert(86.0, 80, emptyList(), false)
+        assertEquals(DriverAlertKind.OVERSPEED, alert?.kind)
+    }
+
+    @Test
+    fun approachingLimitWarnsBeforeCrossing() {
+        val alert = evaluateDriverAlert(73.0, 80, emptyList(), false)
+        assertEquals(DriverAlertKind.APPROACHING_SPEED_LIMIT, alert?.kind)
+    }
+
+    @Test
+    fun speedCameraAheadTriggersAtRoadSpeed() {
+        val event = RoadEvent("cam", RoadEventType.SPEED_CAMERA, LatLng(35.7, 51.4), "دوربین کنترل سرعت", 600)
+        val alert = evaluateDriverAlert(90.0, 100, listOf(event), false)
+        assertEquals(DriverAlertKind.SPEED_CAMERA, alert?.kind)
+    }
+
+    @Test
+    fun distantBumpDoesNotAlertYet() {
+        val event = RoadEvent("bump", RoadEventType.SPEED_BUMP, LatLng(35.7, 51.4), "سرعت‌گیر", 700)
+        val alert = evaluateDriverAlert(50.0, null, listOf(event), false)
+        assertNull(alert)
+    }
+
+    @Test
+    fun offRouteHasHighestPriority() {
+        val event = RoadEvent("cam", RoadEventType.SPEED_CAMERA, LatLng(35.7, 51.4), "دوربین کنترل سرعت", 100)
+        val alert = evaluateDriverAlert(120.0, 80, listOf(event), true)
+        assertEquals(DriverAlertKind.OFF_ROUTE, alert?.kind)
+    }
+}
