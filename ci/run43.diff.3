+package ir.rahyar.app.domain.models
+
+enum class RoadEventType {
+    SPEED_CAMERA,
+    SPEED_BUMP,
+    HAZARD
+}
+
+data class RoadEvent(
+    val id: String,
+    val type: RoadEventType,
+    val location: GeoPoint,
+    val title: String,
+    val distanceAheadMeters: Int,
+    val source: String = "OSM"
+)
+
+data class RoadAwarenessSnapshot(
+    val speedLimitKmh: Int? = null,
+    val events: List<RoadEvent> = emptyList(),
+    val isLive: Boolean = false,
+    val source: String? = null
+)
+
+enum class DriverAlertKind {
+    APPROACHING_SPEED_LIMIT,
+    OVERSPEED,
+    SPEED_CAMERA,
+    SPEED_BUMP,
+    HAZARD,
+    OFF_ROUTE
+}
+
+data class DriverAlert(
+    val kind: DriverAlertKind,
+    val message: String,
+    val distanceMeters: Int? = null,
+    val priority: Int
+)
