+private const val VEHICLE_SOURCE_ID = "rahyar-vehicle-source"
+private const val VEHICLE_LAYER_ID = "rahyar-vehicle-layer"
+private const val VEHICLE_IMAGE_ID = "rahyar-vehicle-image"
+
+private class VehicleRenderState(
+    var location: LatLng? = null,
+    var bearing: Float = 0f,
+    var animator: ValueAnimator? = null
+)
+
+private fun ensureVehicleLayer(
+    map: MapLibreMap,
+    context: android.content.Context,
+    location: LatLng,
+    bearing: Float
+) {
+    val style = map.style ?: return
+    if (style.getImage(VEHICLE_IMAGE_ID) == null) {
+        drawableBitmap(context, R.drawable.ic_vehicle_marker)?.let { bitmap ->
+            style.addImage(VEHICLE_IMAGE_ID, bitmap)
+        }
+    }
+
+    if (style.getSource(VEHICLE_SOURCE_ID) == null) {
+        style.addSource(
+            GeoJsonSource(
+                VEHICLE_SOURCE_ID,
+                vehicleFeature(location, bearing)
+            )
+        )
+    }
+
+    if (style.getLayer(VEHICLE_LAYER_ID) == null) {
+        style.addLayer(
+            SymbolLayer(VEHICLE_LAYER_ID, VEHICLE_SOURCE_ID).withProperties(
+                iconImage(VEHICLE_IMAGE_ID),
+                iconAllowOverlap(true),
+                iconIgnorePlacement(true),
+                iconRotationAlignment("map"),
+                iconRotate(get("bearing")),
+                iconSize(0.78f)
+            )
+        )
+    }
+
+    updateVehicleLayer(map, location, bearing)
+}
