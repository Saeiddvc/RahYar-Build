+    override suspend fun searchAlongRoute(
+        query: String,
+        type: PoiType,
+        route: Route,
+        currentLocation: LatLng
+    ): List<Poi> = withContext(Dispatchers.IO) {
+        if (route.points.size < 2) return@withContext emptyList()
+
+        val minLat = route.points.minOf { it.latitude } - 0.035
+        val maxLat = route.points.maxOf { it.latitude } + 0.035
+        val minLng = route.points.minOf { it.longitude } - 0.045
+        val maxLng = route.points.maxOf { it.longitude } + 0.045
+        val encoded = URLEncoder.encode(query.trim(), Charsets.UTF_8.name())
+        val viewbox = "$minLng,$maxLat,$maxLng,$minLat"
+        val url = URL(
+            "https://nominatim.openstreetmap.org/search" +
+                "?format=jsonv2&addressdetails=1&accept-language=fa&countrycodes=ir&limit=30&bounded=1&viewbox=$viewbox&q=$encoded"
+        )
+        val connection = (url.openConnection() as HttpURLConnection).apply {
+            connectTimeout = 8000
+            readTimeout = 8000
+            requestMethod = "GET"
+            setRequestProperty("User-Agent", "RahYar/1.5.7 Android")
+            setRequestProperty("Accept", "application/json")
+        }
+        try {
+            if (connection.responseCode !in 200..299) return@withContext emptyList()
+            val body = connection.inputStream.bufferedReader().use { it.readText() }
+            val array = JSONArray(body)
+            val currentIndex = nearestRouteIndex(route, currentLocation)
+            buildList {
+                for (i in 0 until array.length()) {
+                    val obj = array.getJSONObject(i)
+                    val lat = obj.optString("lat").toDoubleOrNull() ?: continue
+                    val lon = obj.optString("lon").toDoubleOrNull() ?: continue
+                    val point = LatLng(lat, lon)
+                    val nearestIndex = nearestRouteIndex(route, point)
+                    val distanceFromRoute = distanceMeters(point, route.points[nearestIndex]).roundToInt()
+                    val ahead = nearestIndex + 2 >= currentIndex
+                    if (!ahead || distanceFromRoute > 3500) continue
+                    val display = obj.optString("display_name").trim()
+                    val name = obj.optString("name").trim().ifBlank { display.substringBefore(',').trim().ifBlank { query } }
+                    add(
+                        Poi(
+                            id = "nominatim_${obj.optString("place_id", i.toString())}",
+                            type = type,
+                            name = name,
+                            location = point,
+                            distanceFromRouteMeters = distanceFromRoute,
+                            detourDistanceMeters = 0,
+                            detourDurationMinutes = 0,
+                            isAheadOfUser = true,
+                            isOpenNow = null,
+                            reliability = PoiReliability.UNKNOWN
+                        )
+                    )
+                }
+            }.distinctBy { it.id }.sortedBy { it.distanceFromRouteMeters }.take(8)
+        } finally {
+            connection.disconnect()
+        }
+    }
+
