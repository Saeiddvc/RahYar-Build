diff -ruN Run42Base/app/src/main/java/ir/rahyar/app/core/navigation/DriverAlertEvaluator.kt Run43Source/app/src/main/java/ir/rahyar/app/core/navigation/DriverAlertEvaluator.kt
--- Run42Base/app/src/main/java/ir/rahyar/app/core/navigation/DriverAlertEvaluator.kt	1970-01-01 00:00:00.000000000 +0000
+++ Run43Source/app/src/main/java/ir/rahyar/app/core/navigation/DriverAlertEvaluator.kt	2026-08-31 04:30:48.599495381 +0000
@@ -0,0 +1,70 @@
+package ir.rahyar.app.core.navigation
+
+import ir.rahyar.app.domain.models.DriverAlert
+import ir.rahyar.app.domain.models.DriverAlertKind
+import ir.rahyar.app.domain.models.RoadEvent
+import ir.rahyar.app.domain.models.RoadEventType
+import kotlin.math.max
+
+fun evaluateDriverAlert(
+    speedKmh: Double,
+    speedLimitKmh: Int?,
+    roadEvents: List<RoadEvent>,
+    isOffRoute: Boolean
+): DriverAlert? {
+    if (isOffRoute) {
+        return DriverAlert(
+            kind = DriverAlertKind.OFF_ROUTE,
+            message = "از مسیر خارج شدید",
+            priority = 100
+        )
+    }
+
+    val candidates = mutableListOf<DriverAlert>()
+
+    roadEvents.firstOrNull { event ->
+        val warningDistance = eventWarningDistanceMeters(event.type, speedKmh)
+        event.distanceAheadMeters in 0..warningDistance
+    }?.let { event ->
+        val kind = when (event.type) {
+            RoadEventType.SPEED_CAMERA -> DriverAlertKind.SPEED_CAMERA
+            RoadEventType.SPEED_BUMP -> DriverAlertKind.SPEED_BUMP
+            RoadEventType.HAZARD -> DriverAlertKind.HAZARD
+        }
+        val message = when (event.type) {
+            RoadEventType.SPEED_CAMERA -> "دوربین کنترل سرعت در ${event.distanceAheadMeters} متر"
+            RoadEventType.SPEED_BUMP -> "سرعت‌گیر در ${event.distanceAheadMeters} متر"
+            RoadEventType.HAZARD -> "${event.title} در ${event.distanceAheadMeters} متر"
+        }
+        val priority = when (event.type) {
+            RoadEventType.SPEED_CAMERA -> 90
+            RoadEventType.SPEED_BUMP -> 88
+            RoadEventType.HAZARD -> 82
+        }
+        candidates += DriverAlert(kind, message, event.distanceAheadMeters, priority)
+    }
+
+    if (speedLimitKmh != null && speedLimitKmh > 0) {
+        val overspeedMargin = max(3.0, speedLimitKmh * 0.05)
+        when {
+            speedKmh > speedLimitKmh + overspeedMargin -> candidates += DriverAlert(
+                kind = DriverAlertKind.OVERSPEED,
+                message = "سرعت مجاز ${speedLimitKmh}؛ سرعت را کاهش دهید",
+                priority = 95
+            )
+            speedKmh >= speedLimitKmh * 0.90 -> candidates += DriverAlert(
+                kind = DriverAlertKind.APPROACHING_SPEED_LIMIT,
+                message = "نزدیک سرعت مجاز ${speedLimitKmh} هستید",
+                priority = 60
+            )
+        }
+    }
+
+    return candidates.maxByOrNull { it.priority }
+}
+
+fun eventWarningDistanceMeters(type: RoadEventType, speedKmh: Double): Int = when (type) {
+    RoadEventType.SPEED_CAMERA -> max(450.0, speedKmh * 8.0).coerceAtMost(1_000.0).toInt()
+    RoadEventType.SPEED_BUMP -> max(180.0, speedKmh * 3.2).coerceAtMost(450.0).toInt()
+    RoadEventType.HAZARD -> max(350.0, speedKmh * 6.0).coerceAtMost(900.0).toInt()
+}
