+import ir.rahyar.app.domain.models.LatLng
+import ir.rahyar.app.domain.models.Route
+import kotlin.math.atan2
+import kotlin.math.cos
+import kotlin.math.roundToInt
+import kotlin.math.sin
+import kotlin.math.sqrt
+
+data class PoiRouteMatch(
+    val distanceFromRouteMeters: Int,
+    val distanceAheadMeters: Int,
+    val isAheadOfUser: Boolean
+)
+
+fun aheadRouteWindow(
+    route: Route,
+    currentLocation: LatLng,
+    maxAheadMeters: Double
+): List<LatLng> {
+    if (route.points.size < 2 || maxAheadMeters <= 0.0) return emptyList()
+    val currentIndex = nearestRouteIndex(route.points, currentLocation)
+    val result = mutableListOf(route.points[currentIndex])
+    var travelled = 0.0
+    var i = currentIndex
+    while (i < route.points.lastIndex && travelled < maxAheadMeters) {
+        travelled += geoDistanceMeters(route.points[i], route.points[i + 1])
+        result += route.points[i + 1]
+        i++
+    }
+    return result
+}
+
+fun matchPoiToAheadRoute(
+    route: Route,
+    currentLocation: LatLng,
+    poiLocation: LatLng,
+    maxDistanceFromRouteMeters: Double = 1_200.0,
+    maxAheadMeters: Double = 25_000.0
+): PoiRouteMatch? {
+    if (route.points.size < 2) return null
+    val currentIndex = nearestRouteIndex(route.points, currentLocation)
+    var bestIndex = -1
+    var bestDistance = Double.MAX_VALUE
+    var distanceAhead = 0.0
+    var cumulative = 0.0
+
+    for (i in currentIndex..route.points.lastIndex) {
+        if (i > currentIndex) cumulative += geoDistanceMeters(route.points[i - 1], route.points[i])
+        if (cumulative > maxAheadMeters) break
+        val d = geoDistanceMeters(route.points[i], poiLocation)
+        if (d < bestDistance) {
+            bestDistance = d
+            bestIndex = i
+            distanceAhead = cumulative
+        }
+    }
+
+    if (bestIndex < currentIndex || bestDistance > maxDistanceFromRouteMeters || distanceAhead > maxAheadMeters) return null
+    return PoiRouteMatch(
+        distanceFromRouteMeters = bestDistance.roundToInt(),
+        distanceAheadMeters = distanceAhead.roundToInt(),
+        isAheadOfUser = true
+    )
+}
+
+private fun nearestRouteIndex(points: List<LatLng>, point: LatLng): Int =
+    points.indices.minByOrNull { geoDistanceMeters(points[it], point) } ?: 0
+
+private fun geoDistanceMeters(a: LatLng, b: LatLng): Double {
+    val r = 6_371_000.0
+    val dLat = Math.toRadians(b.latitude - a.latitude)
+    val dLon = Math.toRadians(b.longitude - a.longitude)
+    val lat1 = Math.toRadians(a.latitude)
+    val lat2 = Math.toRadians(b.latitude)
+    val h = sin(dLat / 2) * sin(dLat / 2) + cos(lat1) * cos(lat2) * sin(dLon / 2) * sin(dLon / 2)
+    return r * 2 * atan2(sqrt(h), sqrt(1 - h))
+}
