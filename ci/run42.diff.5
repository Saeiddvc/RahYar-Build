+
+private fun vehicleFeature(location: LatLng, bearing: Float): Feature =
+    Feature.fromGeometry(Point.fromLngLat(location.longitude, location.latitude)).apply {
+        addNumberProperty("bearing", bearing)
+    }
+
+private fun drawableBitmap(context: android.content.Context, resId: Int): Bitmap? {
+    val drawable = ContextCompat.getDrawable(context, resId) ?: return null
+    val width = drawable.intrinsicWidth.coerceAtLeast(52)
+    val height = drawable.intrinsicHeight.coerceAtLeast(52)
+    return Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888).also { bitmap ->
+        val canvas = Canvas(bitmap)
+        drawable.setBounds(0, 0, canvas.width, canvas.height)
+        drawable.draw(canvas)
+    }
+}
