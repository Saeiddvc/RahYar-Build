+++ b/app/src/main/java/ir/rahyar/app/domain/models/NavigationContracts.kt	2026-08-30 15:10:00.048619499 +0000
@@ -0,0 +1,50 @@
+package ir.rahyar.app.domain.models
+
+data class Poi(
+    val id: String,
+    val type: PoiType,
+    val name: String,
+    val location: GeoPoint,
+    val distanceFromRouteMeters: Int,
+    val detourDistanceMeters: Int,
+    val detourDurationMinutes: Int,
+    val isAheadOfUser: Boolean,
+    val isOpenNow: Boolean?,
+    val reliability: PoiReliability?
+)
+
+enum class PoiType {
+    GAS_STATION, REST_AREA, TOILET, PARKING, FOOD, CAFE,
+    HOSPITAL, EMERGENCY, SIGHTSEEING, USER_SAVED
+}
+
+enum class PoiReliability { VERIFIED, HIGH, MEDIUM, LOW, UNKNOWN }
+
+enum class MapViewMode { NORTH_UP, HEADING_UP, THREE_D }
+
+data class QuickSettings(
+    val voiceGuidanceEnabled: Boolean,
+    val voiceAlertsEnabled: Boolean,
+    val mapViewMode: MapViewMode,
+    val showTraffic: Boolean,
+    val avoidTrafficZone: Boolean,
+    val avoidPollutionZone: Boolean,
+    val avoidTollRoads: Boolean,
+    val rerouteOnHeavyTraffic: Boolean,
+    val rerouteOnSevereWeather: Boolean,
+    val speedLimitAlertsEnabled: Boolean
+)
+
+data class PersonalPlace(
+    val id: String,
+    val name: String,
+    val location: GeoPoint,
+    val iconRes: Int
+)
+
+data class CameraPadding(
+    val top: Int,
+    val bottom: Int,
+    val start: Int,
+    val end: Int
+)
