+
+    @Test
+    fun nearbyBumpTriggersWarning() {
+        val event = RoadEvent("bump", RoadEventType.SPEED_BUMP, LatLng(35.7, 51.4), "سرعت‌گیر", 120)
+        val alert = evaluateDriverAlert(50.0, null, listOf(event), false)
+        assertEquals(DriverAlertKind.SPEED_BUMP, alert?.kind)
+    }
+
+    @Test
+    fun nearbyHazardTriggersWarning() {
+        val event = RoadEvent("hazard", RoadEventType.HAZARD, LatLng(35.7, 51.4), "خطر جاده", 250)
+        val alert = evaluateDriverAlert(70.0, null, listOf(event), false)
+        assertEquals(DriverAlertKind.HAZARD, alert?.kind)
+    }
+
+    @Test
+    fun offRouteAlertOverridesOverspeedAndRoadEvent() {
+        val event = RoadEvent("cam", RoadEventType.SPEED_CAMERA, LatLng(35.7, 51.4), "دوربین", 80)
+        val alert = evaluateDriverAlert(120.0, 80, listOf(event), true)
+        assertEquals(DriverAlertKind.OFF_ROUTE, alert?.kind)
+    }
