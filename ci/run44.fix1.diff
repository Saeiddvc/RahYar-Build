+package ir.rahyar.app.core.navigation
+
+import ir.rahyar.app.domain.models.LatLng
+import ir.rahyar.app.domain.models.Route
+import ir.rahyar.app.domain.models.RouteType
+import ir.rahyar.app.domain.models.TransportMode
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+import java.time.LocalDateTime
+
+class PoiDetourTest {
+    private fun route(distanceKm: Double, durationMinutes: Int): Route = Route(
+        id = "r-$distanceKm-$durationMinutes",
+        type = RouteType.RECOMMENDED,
+        points = listOf(LatLng(35.83, 50.95), LatLng(35.82, 51.00)),
+        durationMinutes = durationMinutes,
+        distanceKm = distanceKm,
+        eta = LocalDateTime.now(),
+        transportMode = TransportMode.CAR
+    )
+
+    @Test
+    fun realRouteDifferenceProducesDetourDistanceAndDuration() {
+        val detour = calculatePoiDetour(
+            baseRoute = route(7.0, 18),
+            routeWithStop = route(8.25, 23)
+        )
+        assertEquals(1250, detour?.distanceMeters)
+        assertEquals(5, detour?.durationMinutes)
+    }
+
+    @Test
+    fun unavailableBaseRouteNeverProducesFakeZeroDetour() {
+        assertNull(calculatePoiDetour(route(0.0, 0), route(8.25, 23)))
+    }
+
+    @Test
+    fun unavailableStopRouteNeverProducesFakeZeroDetour() {
+        assertNull(calculatePoiDetour(route(7.0, 18), route(0.0, 0)))
+    }
+
+    @Test
+    fun validAlternativeWithNoAddedCostMayReturnRealZero() {
+        val detour = calculatePoiDetour(route(7.0, 18), route(6.8, 17))
+        assertEquals(0, detour?.distanceMeters)
+        assertEquals(0, detour?.durationMinutes)
+    }
+}
