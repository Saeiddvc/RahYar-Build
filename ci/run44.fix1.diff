+
+    @Test fun arrivingAtStopThenSelectingContinuationRouteKeepsFinalDestinationAndSessionAlive() {
+        val session = NavigationSession()
+        val origin = LatLng(35.83, 50.95)
+        val destination = LatLng(35.82, 51.00)
+        session.setOrigin(origin)
+        session.setDestination(destination)
+        session.addStop(LatLng(35.825, 50.98), "fuel-1")
+        session.beginNavigation(route("to-stop"))
+
+        session.updateStopStatus("fuel-1", StopStatus.ARRIVED)
+        session.selectRoute(route("continue-to-destination"))
+
+        val state = session.state.value
+        assertEquals(destination, state.destination)
+        assertEquals(destination, state.itinerary?.destination)
+        assertEquals(StopStatus.ARRIVED, state.itinerary?.stops?.single()?.status)
+        assertTrue(state.navigationState is NavigationState.Navigating)
+    }
 }
