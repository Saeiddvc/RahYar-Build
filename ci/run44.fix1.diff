+package ir.rahyar.app.core.navigation
+
+import ir.rahyar.app.domain.models.Route
+import kotlin.math.roundToInt
+
+data class PoiDetourMetrics(
+    val distanceMeters: Int,
+    val durationMinutes: Int
+)
+
+fun calculatePoiDetour(baseRoute: Route, routeWithStop: Route): PoiDetourMetrics? {
+    if (baseRoute.distanceKm <= 0.0 || baseRoute.durationMinutes <= 0) return null
+    if (routeWithStop.distanceKm <= 0.0 || routeWithStop.durationMinutes <= 0) return null
+
+    return PoiDetourMetrics(
+        distanceMeters = (
+            (routeWithStop.distanceKm - baseRoute.distanceKm)
+                .coerceAtLeast(0.0) * 1000.0
+            ).roundToInt(),
+        durationMinutes = (routeWithStop.durationMinutes - baseRoute.durationMinutes).coerceAtLeast(0)
+    )
+}
