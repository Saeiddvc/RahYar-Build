 thresholdMeters = threshold)
+}
+
+fun shouldSnapToRoute(
+    distanceFromRouteMeters: Double,
+    horizontalAccuracyMeters: Double,
+    speedMps: Double,
+    headingDifferenceDegrees: Float?
+): Boolean {
+    val accuracy = horizontalAccuracyMeters.coerceIn(3.0, 35.0)
+    val threshold = (accuracy * 1.15 + if (speedMps > 12.0) 5.0 else 2.0).coerceIn(8.0, 28.0)
+    val headingAcceptable = headingDifferenceDegrees == null || speedMps < 2.0 || headingDifferenceDegrees <= 65f
+    return distanceFromRouteMeters <= threshold && headingAcceptable
+}
+
+fun interpolateGeoPoint(from: LatLng, to: LatLng, fraction: Float): LatLng {
+    val f = fraction.coerceIn(0f, 1f).toDouble()
+    return LatLng(
+        latitude = from.latitude + (to.latitude - from.latitude) * f,
+        longitude = from.longitude + (to.longitude - from.longitude) * f
+    )
+}
+
+fun interpolateBearing(from: Float, to: Float, fraction: Float): Float {
+    val normalizedFrom = ((from % 360f) + 360f) % 360f
+    val normalizedTo = ((to % 360f) + 360f) % 360f
+    var delta = normalizedTo - normalizedFrom
+    if (delta > 180f) delta -= 360f
+    if (delta < -180f) delta += 360f
+    return ((normalizedFrom + delta * fraction.coerceIn(0f, 1f)) % 360f + 360f) % 360f
+}
+
+fun forwardPoint(origin: LatLng, bearingDegrees: Float, distanceMeters: Double): LatLng {
+    if (distanceMeters <= 0.0) return origin
+    val radius = 6_371_000.0
+    val angular = distanceMeters / radius
+    val bearing = Math.toRadians(bearingDegrees.toDouble())
+    val lat1 = Math.toRadians(origin.latitude)
+    val lon1 = Math.toRadians(origin.longitude)
+    val lat2 = kotlin.math.asin(sin(lat1) * kotlin.math.cos(angular) + cos(lat1) * kotlin.math.sin(angular) * cos(bearing))
+    val lon2 = lon1 + atan2(
+        sin(bearing) * kotlin.math.sin(angular) * cos(lat1),
+        kotlin.math.cos(angular) - sin(lat1) * sin(lat2)
+    )
+    return LatLng(Math.toDegrees(lat2), Math.toDegrees(lon2))
+}
+
+private fun bearingDegrees(a: LatLng, b: LatLng): Float {
+    val lat1 = Math.toRadians(a.latitude)
+    val lat2 = Math.toRadians(b.latitude)
+    val deltaLon = Math.toRadians(b.longitude - a.longitude)
+    val y = sin(deltaLon) * cos(lat2)
+    val x = cos(lat1) * sin(lat2) - sin(lat1) * cos(lat2) * cos(deltaLon)
+    return ((Math.toDegrees(atan2(y, x)) + 360.0) % 360.0).toFloat()
+}
+
+private fun distanceMeters(a: LatLng, b: LatLng): Double {
+    val radius = 6_371_000.0
+    val dLat = Math.toRadians(b.latitude - a.latitude)
+    val dLon = Math.toRadians(b.longitude - a.longitude)
+    val lat1 = Math.toRadians(a.latitude)
+    val lat2 = Math.toRadians(b.latitude)
+    val h = sin(dLat / 2) * sin(dLat / 2) + cos(lat1) * cos(lat2) * sin(dLon / 2) * sin(dLon / 2)
+    return radius * 2 * atan2(sqrt(h), sqrt(1 - h))
+}
